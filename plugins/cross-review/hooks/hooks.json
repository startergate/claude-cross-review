{
  "description": "Reminds Claude to run cross-review before reporting work, and to follow up on the Codex review after it opens a pull request.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/cross-review/scripts/cross_review.py\" hook-session-start || true",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/cross-review/scripts/cross_review.py\" hook-pr-created || true",
            "if": "Bash(gh pr create *)",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
